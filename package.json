{
  "name": "moksy",
  "version": "0.1.0-rc.2",
  "description": "API Simulator that turns API agreements into callable mock endpoints",
  "type": "module",
  "bin": {
    "moksy": "./bin/moksy.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "templates"
  ],
  "scripts": {
    "build": "rsbuild build && vite build --config vite.dashboard.config.ts && vite build --config vite.react.config.ts && tsc -p src/react/tsconfig.json",
    "build:dashboard": "vite build --config vite.dashboard.config.ts",
    "dev:dashboard": "vite --config vite.dashboard.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p src/modules/dashboard/ui/tsconfig.json && tsc -p src/react/tsconfig.json --noEmit",
    "artifact": "node -e \"const fs = require('fs'); if (!fs.existsSync('.artifacts')) fs.mkdirSync('.artifacts');\" && npm pack --pack-destination=.artifacts"
  },
  "keywords": [
    "mock",
    "api",
    "simulator",
    "fastify",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "adm-zip": "^0.6.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "lodash": "^4.18.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.14",
    "@types/adm-zip": "^0.5.8",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rsbuild-plugin-dts": "^1.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
